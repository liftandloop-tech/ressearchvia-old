# ==============================================================================
# 13. AUTOMATED TRADING ENGINE TUNING, QUEUES & RISK
# ==============================================================================
LL_BACKEND_URL=http://ll-backend:8080
OUTBOX_BATCH_SIZE=50
ORDER_PLACEMENT_CONCURRENCY=20
ORDER_MONITORING_CONCURRENCY=50
BROKER_TIMEOUT_MS=5000
BROKER_RATE_LIMIT_PER_MINUTE=100
SIGNAL_PROCESSING_LIMIT=50
CIRCUIT_BREAKER_FAILURE_THRESHOLD=3
CIRCUIT_BREAKER_RESET_TIMEOUT_MS=60000
RISK_DEFAULT_MODE=ALLOW
RISK_FREE_RATE_ANNUAL=6.5
RECON_PNL_TOLERANCE_PERCENT=0.50
RECON_PRICE_TOLERANCE_PERCENT=0.10
WS_WORKER_CONCURRENCY=20

# ==============================================================================
# 14. MIGRATION FLAGS & V4 ORCHESTRATOR
# ==============================================================================
ENTITLEMENT_MIGRATION_STAGE=STRICT
LOG_MIGRATION_MISMATCHES_SAMPLING=1.0
STOP_MIGRATION=false
USE_V4_ORCHESTRATOR=true
