# ==============================================================================
# PUBLIC DOMAIN CONFIGURATION (Gateway Reverse Proxy)
# ==============================================================================
# Domain for Main Express Backend (l-l-backend)
DOMAIN_BACKEND=apitest.researchvia.in

# Domain for Flutter Web Admin Panel (spresearchvia-admin-panel)
DOMAIN_ADMIN=admintest.researchvia.in

# Domain for Automated Trading Engine API (automated-api-one)
DOMAIN_AUTOMATED_API=tradetest.researchvia.in

# Ingress Gateway Exposed Host Ports (Set to alternative ports so they do not collide with Coolify on 80/443)
HTTP_PORT=8088
HTTPS_PORT=8443

# ==============================================================================
# ENVIRONMENT & CORE SETTINGS
# ==============================================================================
NODE_ENV=production
ALLOW_ACCESS_ORIGIN=*

# ==============================================================================
# INTERNAL POSTGRESQL DATABASE CONFIGURATION (Private Network)
# ==============================================================================
POSTGRES_USER=postgres
POSTGRES_PASSWORD=your_secure_postgres_password_here_min_16_chars
POSTGRES_DB=trading_platform

# ==============================================================================
# INTERNAL REDIS CACHE & QUEUE CONFIGURATION (Private Network)
# ==============================================================================
REDIS_PASSWORD=

# ==============================================================================
# INTERNAL MONGODB CONFIGURATION (Private Network)
# ==============================================================================
# Internal Docker mongo service or external MongoDB Atlas connection URI
MONGO_DB_URL=mongodb://mongo:27017/researchvia

# ==============================================================================
# AUTHENTICATION & SECURITY SECRETS
# ==============================================================================
JWT_TOKEN=your_main_backend_super_secret_jwt_token_key_here
JWT_SECRET=your_automated_api_jwt_access_key_min_32_chars
JWT_REFRESH_SECRET=your_automated_api_jwt_refresh_key_min_32_chars
AUTOMATED_API_KEY=shared_secret_api_key_between_ll_backend_and_automated_api

# ==============================================================================
# EGRESS PROXY & EGRESS MANAGER (Private Network)
# ==============================================================================
PROXY_CONTROL_SECRET=s8_egress_super_secret_control_key_2026
ALLOW_DEV_FALLBACK_IP=false

# ==============================================================================
# PAYMENT GATEWAY & NOTIFICATION INTEGRATIONS (Main Backend)
# ==============================================================================
CURRENCY=INR
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=

# Firebase Admin SDK (Base64 string or JSON)
FIREBASE_SERVICE_ACCOUNT_BASE64=
FIREBASE_SERVICE_ACCOUNT_JSON=

# Twilio SMS
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_SERVICE_SID=

# ==============================================================================
# BROKER & ALERT INTEGRATIONS (Automated Trading API)
# ==============================================================================
MOCK_BROKERS=false
ANGEL_ONE_API_KEY=
ANGEL_ONE_REDIRECT_URL=
MSG91_API_KEY=
FCM_PROJECT_ID=
FCM_PRIVATE_KEY=
RESEND_API_KEY=
