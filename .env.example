# ==============================================================================
# 1. PUBLIC DOMAIN & INGRESS GATEWAY CONFIGURATION
# ==============================================================================
# Domain for Main Express Backend (l-l-backend)
DOMAIN_BACKEND=test.researchvia.in

# Domain for Flutter Web Admin Panel (spresearchvia-admin-panel)
DOMAIN_ADMIN=admintest.researchvia.in

# Domain for Automated Trading Engine API (automated-api-one)
DOMAIN_AUTOMATED_API=tradetest.researchvia.in

# Ingress Gateway Exposed Host Ports (Set to alternative ports if running alongside Coolify/Traefik on 80/443)
HTTP_PORT=8088
HTTPS_PORT=8443

# ==============================================================================
# 2. ENVIRONMENT & CORE SYSTEM SETTINGS
# ==============================================================================
NODE_ENV=production
ALLOW_ACCESS_ORIGIN=*
PORT=8080
NIXPACKS_NODE_VERSION=22

# URLs for API links and Frontend dashboard redirects
BASE_URL=https://test.researchvia.in
FRONTEND_URL=https://admintest.researchvia.in

# ==============================================================================
# 3. INTERNAL POSTGRESQL DATABASE CONFIGURATION
# ==============================================================================
POSTGRES_USER=postgres
POSTGRES_PASSWORD=your_secure_postgres_password_here
POSTGRES_DB=trading_platform
DATABASE_URL="postgresql://postgres:your_secure_postgres_password_here@postgres:5432/trading_platform?schema=public"

# ==============================================================================
# 4. INTERNAL REDIS CACHE & BULLMQ QUEUE CONFIGURATION
# ==============================================================================
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_USERNAME=default
REDIS_PASSWORD=your_redis_password_here
REDIS_URL=redis://:your_redis_password_here@redis:6379/0

# ==============================================================================
# 5. MONGODB DATABASE CONFIGURATION
# ==============================================================================
DB_URL=mongodb://root:password@72.60.221.95:27017/researchvia-t?authSource=admin
MONGO_DB_URL=mongodb://root:password@72.60.221.95:27017/researchvia-t?authSource=admin
MONGO_URI=mongodb://root:password@72.60.221.95:27017/researchvia-t?authSource=admin

# ==============================================================================
# 6. AUTHENTICATION & CROSS-SERVICE SECURITY SECRETS
# ==============================================================================
JWT_TOKEN=your_jwt_secret_for_main_backend
JWT_SECRET=your_jwt_secret_for_automated_api_at_least_32_chars
JWT_REFRESH_SECRET=your_jwt_refresh_secret_at_least_32_chars
AUTOMATED_API_KEY=shared_secret_api_key_between_services

# ==============================================================================
# 7. EGRESS PROXY & EGRESS MANAGER (Private Broker Outbound Network)
# ==============================================================================
PROXY_CONTROL_SECRET=s8_egress_super_secret_control_key_2026
ALLOW_DEV_FALLBACK_IP=false
EGRESS_MANAGER_URL=http://egress-manager:8080
EGRESS_PROXY_HOST=egress-proxy
EGRESS_PROXY_PORT=8888
PROXY_DATA_PORT=8888
PROXY_CONTROL_PORT=8889
IP_ECHO_ENDPOINT=http://api.ipify.org?format=json

# ==============================================================================
# 8. PAYMENT GATEWAY (Razorpay)
# ==============================================================================
CURRENCY=INR
RAZORPAY_KEY_ID=your_razorpay_key_id
RAZORPAY_KEY_SECRET=your_razorpay_key_secret

# ==============================================================================
# 9. FIREBASE & PUSH NOTIFICATIONS
# ==============================================================================
FCM_PROJECT_ID=researchvia-adb42
FCM_PRIVATE_KEY=mock_fcm_private_key
FIREBASE_SERVICE_ACCOUNT_JSON=
