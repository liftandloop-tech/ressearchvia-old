# ==============================================================================
# ENVIRONMENT & GENERAL CONFIGURATION
# ==============================================================================
NODE_ENV=production
PORT=3000

# ==============================================================================
# POSTGRESQL DATABASE CONFIGURATION
# ==============================================================================
POSTGRES_USER=postgres
POSTGRES_PASSWORD=your_secure_postgres_password_here
POSTGRES_DB=trading_platform
POSTGRES_PORT=5432

# ==============================================================================
# REDIS CACHE & MESSAGE QUEUE
# ==============================================================================
REDIS_PORT=6379
REDIS_PASSWORD=

# ==============================================================================
# AUTHENTICATION & SECURITY SECRETS
# ==============================================================================
JWT_SECRET=your_super_secret_jwt_access_key_min_32_chars
JWT_REFRESH_SECRET=your_super_secret_jwt_refresh_key_min_32_chars
AUTOMATED_API_KEY=your_automated_internal_api_key

# ==============================================================================
# EGRESS PROXY & EGRESS MANAGER
# ==============================================================================
PROXY_DATA_PORT=8888
PROXY_CONTROL_PORT=8889
PROXY_CONTROL_SECRET=s8_egress_super_secret_control_key_2026
ALLOW_DEV_FALLBACK_IP=false
EGRESS_MANAGER_PORT=8080

# ==============================================================================
# SERVICE INTEGRATIONS & UPSTREAM APIS
# ==============================================================================
MOCK_BROKERS=false
LL_BACKEND_URL=http://localhost:8080

# Optional 3rd Party Broker & Notification Credentials
ANGEL_ONE_API_KEY=
ANGEL_ONE_REDIRECT_URL=
MSG91_API_KEY=
FCM_PROJECT_ID=
FCM_PRIVATE_KEY=
RESEND_API_KEY=
