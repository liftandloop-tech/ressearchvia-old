{
  "moduleFileExtensions": ["js", "json", "ts"],
  "rootDir": ".",
  "testEnvironment": "node",
  "testRegex": ".e2e-spec.ts$",
  "transform": {
    "^.+\\.(t|j)s$": "ts-jest"
  },
  "setupFiles": ["<rootDir>/setup-e2e.ts"],
  "moduleNameMapper": {
    "^https-proxy-agent$": "<rootDir>/../__mocks__/https-proxy-agent.js"
  }
}
